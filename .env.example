# Base de données PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/einvoice

# Bindings
API_BIND=0.0.0.0:3000
WEB_BIND=0.0.0.0:8080

# Logs
RUST_LOG=info,einvoice_api=debug,einvoice_web=debug

# SMTP (delivery::email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="einvoice-rs <no-reply@example.org>"

# Chorus Pro / PISTE (delivery::chorus_pro)
CHORUS_PRO_BASE_URL=https://sandbox-api.piste.gouv.fr
CHORUS_PRO_CLIENT_ID=
CHORUS_PRO_CLIENT_SECRET=
